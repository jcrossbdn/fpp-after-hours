# Installed by the fpp-after-hours plugin (scripts/fpp_install.sh).
#
# A small pipewire-pulse server of this plugin's own, joined to FPP's PipeWire
# graph, that listens ONLY on /run/fpp-after-hours/pulse-native. MPD (which
# runs as fpp) plays through it, so its audio mixes into the same sinks as
# fppd's show audio.
#
# Why a separate server instead of FPP's own fpp-pipewire-pulse.service:
#  - MPD runs as fpp and cannot use FPP's socket: FPP's root pactl calls reset
#    /run/pipewire-fpp/pulse to root-only 0700.
#  - Adding a socket to FPP's server needs a drop-in in /etc/pipewire, which
#    every pipewire-pulse on the box reads (other plugins run their own), and
#    a hook on FPP's unit. This unit touches neither (issue #62).
#
# Its config lives in a plugin-owned directory passed via PIPEWIRE_CONFIG_DIR.
# With that set, PipeWire reads the main file and the drop-ins ONLY from there,
# so nothing in /etc/pipewire affects this instance and nothing here affects
# any other instance.

[Unit]
Description=FPP After Hours - PulseAudio socket for MPD on FPP's PipeWire graph
Documentation=https://github.com/jcrossbdn/fpp-after-hours
# Follow FPP's PipeWire daemon: started with it (WantedBy below), stopped with
# it, and never started on its own - FPP brings its audio stack up on demand
# from fppinit, so this unit must not pull it in early at boot.
After=fpp-pipewire.service fpp-wireplumber.service
BindsTo=fpp-pipewire.service

[Service]
Type=simple
# FPP's graph socket (/run/pipewire-fpp/pipewire-0) is root:audio 0755, and
# connect() needs write permission on it, so - like FPP's own pulse server -
# this has to run as root. Same privilege level and limits as FPP's unit.
User=root
Group=audio
# FPP's graph, but our own runtime/state paths so nothing is written under
# /run/pipewire-fpp.
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire-fpp
Environment=XDG_RUNTIME_DIR=/run/fpp-after-hours
Environment=PULSE_RUNTIME_PATH=/run/fpp-after-hours
Environment=PIPEWIRE_STATE_DIR=/run/fpp-after-hours/state
Environment=PULSE_STATE_PATH=/run/fpp-after-hours/state
Environment=PIPEWIRE_CONFIG_DIR=/etc/fpp-after-hours/pipewire
# root:audio 0750 - only root and the audio group (MPD runs with
# SupplementaryGroups=audio) can reach the socket. Removed on stop.
RuntimeDirectory=fpp-after-hours fpp-after-hours/state
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/pipewire-pulse
# MPD may have started before this socket existed, or lost its connection when
# FPP restarted its audio stack, and does not reliably reconnect on its own, so
# restart it once the socket is listening. try-restart: only if MPD is running.
# --no-block: MPD is ordered After= this unit, so waiting would deadlock.
# "-": never fail this unit because of MPD.
ExecStartPost=-/bin/sh -c 'i=0; while [ $i -lt 50 ] && [ ! -S /run/fpp-after-hours/pulse-native ]; do sleep 0.2; i=$((i+1)); done; /bin/systemctl --no-block try-restart mpd.service'
Restart=on-failure
RestartSec=3
LimitRTPRIO=95
LimitRTTIME=infinity
AmbientCapabilities=CAP_SYS_NICE

[Install]
WantedBy=fpp-pipewire.service
